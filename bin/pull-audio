def convert_audio():
    for file in audio_dir.iterdir():
        if not file.name.endswith('.opus') and file.name != 'README.md':
            opus = file.with_suffix('.opus')
            cmd = ["ffmpeg", "-i", str(file.absolute()), '-c:a', 'libopus', str(opus)]
            subprocess.run(cmd)
            print(cmd)
            cmd = ["rm", "-f", str(file.absolute())]
            subprocess.run(cmd)
            print(cmd)
def pull_audio():
    for i, (source, label) in enumerate(bgm):
        basename = f"bgm_{i+1:03}_{label}"
        match = list(audio_dir.glob(f"{basename}.*"))
        if match:
            # print(f"file exists, skipping: {source} {match[0]}")
            print(f"file exists, skipping: {source} {basename}")
        else:
            # -x: extract audio only
            # -o: output filename
            cmd = ["yt-dlp", "-xo", audio_dir/basename, source]
            subprocess.run(cmd)
            print(cmd)
def main():
    pull_audio()
    convert_audio()
if __name__=='__main__':
    main()