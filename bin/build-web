#!/bin/bash
set -eu
cd "`dirname "$0"`/.."
# avoid using "latest", for future-proofing
V=8.5.3

mkdir -p ./build

docker run --rm \
  -v "./game:/game/game" \
  -v "./build:/build" \
  -v "./game/assets:/game/assets" \
  -v "./game/assets/Logo/OO2 Logo V3.png:/game/web-presplash.png" \
  dinaki/renpy:$V-web \
  sh -c 'sh renpy.sh launcher set_project /game && sh renpy.sh launcher web_build /game --dest /build/web'
  #-v "./web-presplash.png:/game/web-presplash.png" \
# TODO this really shouldn't require sudo. I haven't figured out docker permissions yet, it creates all files as root. `--user` breaks
sudo chown $(id -u):$(id -g) -R build/web*