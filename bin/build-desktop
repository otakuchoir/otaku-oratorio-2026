#!/bin/bash
set -eu
cd "`dirname "$0"`/.."
# avoid using "latest", for future-proofing
V=8.5.3

mkdir -p ./build

docker run --rm \
  -v "./game:/game" \
  -v "./build:/build" \
  -v "./assets:/assets" \
  dinaki/renpy:$V \
  sh renpy.sh launcher distribute --dest /build --no-update --package pc --package mac --package linux /game
# TODO this really shouldn't require sudo. I haven't figured out docker permissions yet, it creates all files as root. `--user` breaks
sudo chown $(id -u):$(id -g) -R build/*.zip build/*.bz2